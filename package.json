{
  "name": "st-bg-loader",
  "version": "1.0.0",
  "description": "Rich Media Background Plugin for SillyTavern supporting video, audio, HTML5, and SVG animations with hardware decoding and caching",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "test:stress": "node tests/stress.mjs"
  },
  "author": "jiozhaoyue",
  "license": "MIT",
  "homepage": "https://github.com/jiozhaoyue/ST-BgLoader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiozhaoyue/ST-BgLoader.git"
  },
  "keywords": [
    "sillytavern",
    "sillytavern-extension",
    "backgrounds",
    "rich-media",
    "video-background",
    "audio-visualizer",
    "ambient-sound",
    "weather-fx"
  ],
  "devDependencies": {
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
